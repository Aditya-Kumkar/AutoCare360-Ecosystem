# Configure these in Vercel Project Settings > Environment Variables.
# Use the Salesforce My Domain URL, e.g. https://your-domain.my.salesforce.com
# Never add real credentials to this file or commit them to GitHub.
SF_DOMAIN=https://your-domain.my.salesforce.com
SF_CLIENT_ID=replace-with-external-client-app-consumer-key
SF_CLIENT_SECRET=replace-with-external-client-app-consumer-secret

# Live Salesforce workspace (Supabase public project URL and publishable key):
# Public variables below are intentionally available to the frontend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# Server-side variables (same public project URL/key; NOT a Supabase service-role secret):
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SF_RECORD_OBJECT=AutoCare_Record__c
