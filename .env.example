# Configure these in Vercel Project Settings > Environment Variables.
# Use the Salesforce My Domain URL, e.g. https://your-domain.my.salesforce.com
# Never add real credentials to this file or commit them to GitHub.
SF_DOMAIN=https://your-domain.my.salesforce.com
SF_CLIENT_ID=replace-with-external-client-app-consumer-key
SF_CLIENT_SECRET=replace-with-external-client-app-consumer-secret
